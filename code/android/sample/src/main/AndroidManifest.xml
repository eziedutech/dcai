<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signed with the same key as dcAI Guardian, so this signature-level permission is
         granted. It lets the app hand messages to dcAI, the way an app that integrated the
         dcAI safety SDK would. -->
    <uses-permission android:name="dev.eziedutech.dcai.guardian.permission.INGEST" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SampleChat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
