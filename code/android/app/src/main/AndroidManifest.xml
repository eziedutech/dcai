<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Time online: which app is in front and for how long (granted by the user in
         Settings, "Usage access"), and the break screen over other apps. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ package visibility: launcher apps, to read each app's category. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Only an app signed with the same key may hand messages to dcAI (the sample chat app). -->
    <permission
        android:name="dev.eziedutech.dcai.guardian.permission.INGEST"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DcaiGuardian">

        <!-- Google Play requires monitoring apps to declare this. dcAI is a parental-control
             app for a parent to keep their child safe, so the value is child_monitoring.
             (support.google.com/googleplay/android-developer/answer/12955211) -->
        <meta-data android:name="isMonitoringTool" android:value="child_monitoring" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DcaiGuardian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GuardianService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental-control guardian that keeps a persistent, visible notification while active" />
        </service>

        <service
            android:name=".ingest.DcaiKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Incoming messages from chat apps' notifications. The parent grants this access in
             Android's settings; the child sees dcAI in that list. -->
        <service
            android:name=".ingest.MessageNotificationListener"
            android:exported="true"
            android:label="@string/messages_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Screen text across any app (proposal 0002). The parent grants this in Android's
             accessibility settings; the child sees dcAI there and the "dcAI aktif"
             notification stays visible. Not an accessibility aid: the description says so. -->
        <service
            android:name=".ingest.ScreenReaderService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver
            android:name=".ingest.ChatIngestReceiver"
            android:exported="true"
            android:permission="dev.eziedutech.dcai.guardian.permission.INGEST">
            <intent-filter>
                <action android:name="dev.eziedutech.dcai.guardian.INGEST_MESSAGE" />
            </intent-filter>
        </receiver>

        <!-- Apps with the dcAI SDK ask here whether to blur an image. Same signature
             permission as message ingest. -->
        <service
            android:name=".ingest.ImageCheckService"
            android:exported="true"
            android:permission="dev.eziedutech.dcai.guardian.permission.INGEST" />

        <activity
            android:name=".vision.ReviewActivity"
            android:exported="true"
            android:permission="dev.eziedutech.dcai.guardian.permission.INGEST"
            android:theme="@style/Theme.DcaiGuardian" />

        <!-- Site protection: a DNS-only VPN. Only DNS lookups enter it. -->
        <service
            android:name=".sites.SiteGuardVpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name=".screen.TimeOutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.eziedutech.dcai.guardian.timeout"
            android:theme="@style/Theme.DcaiGuardian" />

        <activity
            android:name=".sites.SiteReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.DcaiGuardian" />
    </application>
</manifest>
