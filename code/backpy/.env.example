# Names only. Real values live in .env (git-ignored) or the deploy environment.

# Pools: comma separated endpoint names. Calls rotate across them and fail over on
# rate limits, timeouts and 5xx.
REASONING_ENDPOINTS=meta,fw_muse,bt_muse
# Stage 1 uses the distilled student (Llama 3.1 8B fine-tuned on Muse Spark's labels):
# on the locked test split it matches 70B screening on every safety measure at 46% lower
# pipeline cost (eval/distill/report.md). wb_llama70b is the backup, used only when the student fails (WB_LLAMA70B_BACKUP).
SCREENING_ENDPOINTS=wb_student,wb_llama70b

# Meta Model API (spec names). MUSE_MODEL comes from GET /v1/models, never hardcoded.
# On 27 Oct 2026 the list held muse-spark-1.1, 1.2 and 1.3 (plus "-contributor"
# variants, not used), sam-3.1, muse-image-1.0, muse-voice-transcribe-1.0, muse-wonder-1.0.
# With free credits, Meta may use request content for product improvement: send
# synthetic data only. Remove "meta" from REASONING_ENDPOINTS for any real use.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
# Prices from dev.meta.ai/docs/pricing-rate-limits, 27 Oct 2026 (USD per million tokens).
META_PRICE_IN_PER_MTOK=1.25
META_PRICE_CACHED_PER_MTOK=0.15
META_PRICE_OUT_PER_MTOK=4.25

# Fireworks: one key shared by several endpoints through N_PROVIDER=fireworks.
# Verify the base URL with: python -m app.llm.probe models fireworks muse
FIREWORKS_BASE=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=

FW_MUSE_PROVIDER=fireworks
# Serverless Muse Spark on Fireworks, ID from GET /models on 26 Oct 2026.
FW_MUSE_MODEL=accounts/fireworks/models/muse-spark-open
# Prices shown on the Fireworks model page, 26 Oct 2026 (USD per million tokens).
FW_MUSE_PRICE_IN_PER_MTOK=1.25
FW_MUSE_PRICE_CACHED_PER_MTOK=0.15
FW_MUSE_PRICE_OUT_PER_MTOK=4.25
# Muse Spark always reasons; "none" is refused (HTTP 400). Thinking tokens count toward
# max_tokens and are billed as output.
FW_MUSE_REASONING_EFFORT=low
# json_schema | json_object | none, whichever the endpoint supports (see probe)
FW_MUSE_JSON_MODE=json_schema

# W&B Inference (CoreWeave Forge). Base URL and model IDs from GET /models, 26 Oct 2026.
WANDB_BASE=https://api.inference.wandb.ai/v1
WANDB_API_KEY=

WB_LLAMA8B_PROVIDER=wandb
WB_LLAMA8B_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Prices shown on the W&B Inference model page, 26 Oct 2026 (USD per million tokens).
WB_LLAMA8B_PRICE_IN_PER_MTOK=0.22
WB_LLAMA8B_PRICE_CACHED_PER_MTOK=0.22
WB_LLAMA8B_PRICE_OUT_PER_MTOK=0.22

WB_LLAMA70B_PROVIDER=wandb
WB_LLAMA70B_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Stage 1 backup: used only when the student fails.
WB_LLAMA70B_BACKUP=true
# Prices shown on the W&B Inference model page, 26 Oct 2026 (USD per million tokens).
WB_LLAMA70B_PRICE_IN_PER_MTOK=0.71
WB_LLAMA70B_PRICE_CACHED_PER_MTOK=0.71
WB_LLAMA70B_PRICE_OUT_PER_MTOK=0.71

# Distilled stage 1 student, trained by code/distill/train.py on W&B Serverless Training.
# Base URL and the model name format come from the CoreWeave docs; the model name is
# written to eval/distill/student.json after training.
WB_STUDENT_PROVIDER=wandb
WB_STUDENT_BASE=https://forge.coreweave.com/api/training/v1
WB_STUDENT_MODEL=
WB_STUDENT_JSON_MODE=json_schema
# Trained checkpoints are billed at Serverless Inference rates (Llama 3.1 8B, per M tokens).
WB_STUDENT_PRICE_IN_PER_MTOK=0.22
WB_STUDENT_PRICE_CACHED_PER_MTOK=0.22
WB_STUDENT_PRICE_OUT_PER_MTOK=0.22

LLM_TIMEOUT_SECONDS=20
LLM_MAX_TRANSIENT_RETRIES=2

DATABASE_URL=sqlite:///./dcai.db
SECRET_KEY=
EVIDENCE_ENC_KEY=
REPLAY_MODE=false

# Muse Voice Transcribe (speech to text). Uses the 'meta' endpoint's key and base.
VOICE_ENDPOINT=meta
VOICE_MODEL=muse-voice-transcribe-1.0
# USD 0.18 per hour of audio (dev.meta.ai/docs/pricing-rate-limits).
VOICE_PRICE_PER_HOUR=0.18

# Devices and live updates
PAIRING_CODE_MINUTES=10
DEVICE_MESSAGES_PER_MINUTE=30
SSE_HEARTBEAT_SECONDS=15
# Streams close after this long and the client reconnects with Last-Event-ID.
SSE_MAX_SECONDS=300

# Baseten Model API: Muse Spark Open with hackathon credits. The key works for this model only.
BT_MUSE_BASE=https://inference.baseten.co/v1
BT_MUSE_API_KEY=
BT_MUSE_MODEL=meta-models/muse-spark-open-1026
BT_MUSE_JSON_MODE=json_schema
BT_MUSE_REASONING_EFFORT=low
